{
  "name": "vrt-backend",
  "version": "1.1.0",
  "description": "",
  "author": "",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"test_*/**/*.ts\" \"prisma/**/*.ts\" \"*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"test_*/**/*.ts\" \"prisma/**/*.ts\" \"*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test,test_acceptance,test_ldap,test_oidc,prisma}/**/*.ts\" \"*.ts\"",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --projects src",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --projects src --watch",
    "test:cov": "node --experimental-vm-modules node_modules/jest/bin/jest.js --projects src --coverage",
    "test:debug": "node --experimental-vm-modules --inspect-brk node_modules/jest/bin/jest.js --projects src --runInBand",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --projects test",
    "test:acceptance": "node --experimental-vm-modules node_modules/jest/bin/jest.js --projects test_acceptance",
    "test:ldap": "node --experimental-vm-modules node_modules/jest/bin/jest.js --projects test_ldap",
    "test:oidc": "node --experimental-vm-modules node_modules/jest/bin/jest.js --projects test_oidc",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=24.15"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1160.0",
    "@aws-sdk/s3-request-presigner": "^3.1160.0",
    "@google/genai": "^2.32.0",
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.3.2",
    "@nestjs/jwt": "^12.0.0",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/platform-socket.io": "^12.3.2",
    "@nestjs/schedule": "^12.0.0",
    "@nestjs/swagger": "^12.0.5",
    "@nestjs/terminus": "^12.0.0",
    "@nestjs/websockets": "^12.3.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "ldapts": "^9.2.0",
    "looks-same": "^10.0.1",
    "odiff-bin": "^4.5.0",
    "ollama": "^0.6.4",
    "openid-client": "^5.7.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.3",
    "pixelmatch": "^5.3.0",
    "pngjs": "^7.0.0",
    "redis": "^4.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7",
    "zod-to-json-schema": "^3.25.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.12",
    "@nestjs/testing": "^12.3.2",
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.16.20",
    "@swc/jest": "^0.2.39",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.19.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "axios": "^1.21.0",
    "dotenv": "^18.0.9",
    "eslint": "^10.14.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  },
  "allowScripts": {
    "prisma": true,
    "@prisma/engines": true,
    "@swc/core": true,
    "@scarf/scarf": false,
    "protobufjs": false,
    "unrs-resolver": false,
    "@google/genai": false,
    "@parcel/watcher": false
  }
}
