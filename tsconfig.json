{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "ES2023",
    "lib": ["ES2024", "DOM"],
    "sourceMap": true,
    "incremental": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": [
      "node",
      "jest",
      "multer"
    ],
    "strict": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "src/*": [
        "./src/*"
      ]
    },
    "useDefineForClassFields": false,
    "outDir": "./dist",
    "rootDir": "./"
  },
  "exclude": [
    "node_modules",
    "dist",
    "prisma",
    "noise-bench"
  ]
}
