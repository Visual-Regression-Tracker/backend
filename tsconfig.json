{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "ES2023",
    "sourceMap": true,
    "incremental": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": [
      "node",
      "jest",
      "multer"
    ],
    "strict": false,
    "noImplicitAny": true,
    "useUnknownInCatchVariables": true,
    "paths": {
      "src/*": [
        "./src/*"
      ]
    },
    "useDefineForClassFields": false,
    "outDir": "./dist",
    "rootDir": "./"
  },
  "exclude": [
    "node_modules",
    "dist",
    "prisma"
  ]
}
