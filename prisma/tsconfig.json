{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "ES2021",
    "sourceMap": true,
    "incremental": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    // See: https://github.com/prisma/prisma/issues/10203
    "strictNullChecks": true,
    // TypeScript 6 turns strict on by default and loads no global types; keep
    // the settings this package always compiled with, whichever tsc runs it
    "strict": false,
    "types": ["node", "jest"]
  },
  "exclude": ["node_modules"]
}
