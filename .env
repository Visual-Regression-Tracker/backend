JWT_SECRET='vrt-local-development-only-jwt-secret'
JWT_LIFE_TIME=1d

BODY_PARSER_JSON_LIMIT="5mb"

APP_PORT=4200
APP_FRONTEND_URL=http://localhost:8080

DEFAULT_USER_EMAIL=visual-regression-tracker@example.com
DEFAULT_USER_PASSWORD=123456
DEFAULT_USER_API_KEY=DEFAULTUSERAPIKEYTOBECHANGED

# docker
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vrt_db_dev

# static 
STATIC_SERVICE=hdd # hdd | s3 - hdd as default if not provided
# AWSS3Service uses AWS SDK v3 default credential provider chain.
# You can use env vars below, shared AWS config/credentials, IAM role, web identity, or IAM Identity Center.
# AWS_S3_BUCKET_NAME is required when STATIC_SERVICE=s3.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET_NAME=

# optional

# Multi-instance socket.io fan-out (optional). Unset = in-memory adapter.
#REDIS_URL=redis://localhost:6379
# How long the first Redis connection may take before the API exits instead of waiting (default 30000).

# Log levels, comma separated; unset logs everything. Read from the process environment, not from this file.
#LOG_LEVEL=log,warn,error,fatal

# S3 request timeouts in milliseconds (STATIC_SERVICE=s3)


#REGISTRATION_ENABLED=true

#LDAP_ENABLED=true
#LDAP_TLS_NO_VERIFY=false
#LDAP_URL='ldaps://ldap.example.com:636/'
#LDAP_BIND_USER='CN=searchuser,OU=systemaccounts,DC=example,DC=com'
#LDAP_BIND_PASSWORD='searchuserpassword'
#LDAP_SEARCH_DN='OU=users,DC=example,DC=com'
#LDAP_USERS_SEARCH_FILTER='(&(objectClass=Person)(objectCategory=Person)(|(mail={{email}})(sAMAccountName={{email}})))'
#LDAP_ATTRIBUTE_LAST_NAME='sn'
#LDAP_ATTRIBUTE_FIRST_NAME='givenName'
#LDAP_ATTRIBUTE_MAIL='mail'  

#OIDC_ENABLED=true
#OIDC_ISSUER_URL='https://idp.example.com/realms/example'
#OIDC_CLIENT_ID='vrt-client'
#OIDC_CLIENT_SECRET='clientsecret'
#OIDC_REDIRECT_URI='http://localhost:4200/users/oidc/callback'
#OIDC_SCOPES='openid profile email'
#OIDC_ATTRIBUTE_MAIL='email'
#OIDC_ATTRIBUTE_FIRST_NAME='given_name'
#OIDC_ATTRIBUTE_LAST_NAME='family_name'
# Claim name or dotted path, e.g. 'realm_access.roles' for Keycloak realm roles
#OIDC_ROLE_CLAIM='groups'
#OIDC_ADMIN_VALUES='vrt-admin,admin'
#OIDC_DEFAULT_ROLE='editor'
#OIDC_REQUIRE_VERIFIED_EMAIL=true
#OIDC_TLS_NO_VERIFY=false

#HTTPS_KEY_PATH='./secrets/ssl.key'
#HTTPS_CERT_PATH='./secrets/ssl.cert'
#SERVER_TIMEOUT=120000
#SERVER_HEADERS_TIMEOUT=60000
#SERVER_KEEP_ALIVE_TIMEOUT=5000
OLLAMA_BASE_URL=http://localhost:11434
# DINOv2 service for the rendering-noise filter's "dinov2Check" (see dinov2/README.md)
#DINOV2_URL=http://localhost:8000
#DINOV2_TIMEOUT_MS=60000
#DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vrt_db_dev # required; docker-compose.yml builds it from POSTGRES_*
#MAX_IMAGE_PIXELS=100000000 # largest image in pixels (width x height); 0 turns the limit off
#MULTIPART_FILE_SIZE_LIMIT=104857600 # largest multipart upload in bytes (100 MiB)
#DIFF_WORKERS_COUNT= # diff worker threads; unset: CPUs minus 1, between 1 and 8
#DIFF_QUEUE_LIMIT=256 # diff jobs waiting for a worker; when full the API answers 503
#DIFF_WORKER_MAX_HEAP_MB=512 # heap limit of each diff worker, MB
